# Copie este ficheiro para .env. Nunca publique as suas chaves.
APP_NAME=Drexier
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-before-use
DATABASE_URL=sqlite:///./data/drexier.db

# ==============================================================================
# Google Gemini AI - Motor Principal de Resposta e Condução de Conversas
# Obtenha a sua API Key gratuita em: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=gemini

# Integração opcional com provedores compatíveis com OpenAI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# A integração WhatsApp fica preparada para ativação posterior.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
