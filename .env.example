# ==============================================================================
# 1. SUPABASE (BANCO DE DADOS PRINCIPAL & ÚNICO - POSTGRESQL NUVEM)
# ==============================================================================
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# Insira aqui a URL do seu projeto Supabase:
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon (Project Settings > API > Project API keys > anon public):
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Chave secreta de serviço (Project Settings > API > Project API keys > service_role secret):
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Conexão direta ou referência ao Supabase:
DATABASE_URL=supabase://https://seu-projeto.supabase.co

# ==============================================================================
# 2. CONFIGURAÇÕES DA APLICAÇÃO DREXIER
# ==============================================================================
APP_NAME=Drexier
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-before-use

# ==============================================================================
# 3. GOOGLE GEMINI AI - MOTOR DE INTELIGÊNCIA ARTIFICIAL
# ==============================================================================
# Obtenha gratuitamente a sua API Key em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini

# Opcional: Provedor compatível com OpenAI (se preferir)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# ==============================================================================
# 4. CANAL DE ATENDIMENTO OFICIAL ATIVO - GOOGLE GMAIL
# ==============================================================================
# Obtenha no Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/google/callback

# ==============================================================================
# 5. STRIPE PAYMENTS (FATURAÇÃO RECORRENTE SAAS - PLANO BUSINESS 59€/MÊS)
# ==============================================================================
# Obtenha em: https://dashboard.stripe.com/apikeys
# Chave Secreta da Stripe (sk_test_... em teste ou sk_live_... em produção):
STRIPE_SECRET_KEY=

# Chave Pública da Stripe (pk_test_... ou pk_live_...):
STRIPE_PUBLISHABLE_KEY=

# Segredo de Assinatura do Webhook Stripe (Developers > Webhooks > Assinatura do Endpoint - whsec_...):
STRIPE_WEBHOOK_SECRET=

# ID de Preço Stripe (Opcional - se vazio, cria dinamicamente a subscrição de 59€/mês com 3D Secure):
STRIPE_PRICE_ID=

# Configuração do Plano Business
STRIPE_PLAN_NAME=Plano Business
STRIPE_PLAN_AMOUNT=59.00
STRIPE_PLAN_CURRENCY=eur

# URL pública da sua aplicação para retornos do Stripe Checkout:
PUBLIC_URL=http://localhost:8000

# ==============================================================================
# 6. INTEGRAÇÕES DESATIVADAS NO SOFTWARE (TABELAS MANTIDAS NO BANCO DE DADOS)
# ==============================================================================
# As tabelas correspondentes continuam criadas no Supabase para futura expansão,
# mas as opções e botões foram desativados na interface do software.

# --- Microsoft Outlook (Desativado) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/email/oauth/microsoft/callback
MICROSOFT_TENANT_ID=common

# --- Servidor Direto SMTP / IMAP (Desativado) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993

# --- Meta WhatsApp Cloud API & Número (Desativado) ---
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_SYSTEM_USER_TOKEN=
PUBLIC_URL=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
