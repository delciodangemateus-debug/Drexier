# ==============================================================================
# CONFIGURAÇÕES GERAIS DO DREXIER
# ==============================================================================
APP_NAME=Drexier
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-before-use
DATABASE_URL=sqlite:///./data/drexier.db

# ==============================================================================
# Google Gemini AI - Motor Principal de Resposta e Condução de Conversas
# Obtenha a sua API Key gratuita em: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini

# Integração opcional com provedores compatíveis com OpenAI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# ==============================================================================
# INTEGRAÇÃO DE E-MAIL OFICIAL - CANAL PRINCIPAL DE ATENDIMENTO
# O Drexier agora atende dúvidas, conduz clientes e automatiza respostas via E-mail.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GMAIL (OAuth 2.0 Oficial com consentimento de permissões)
# ------------------------------------------------------------------------------
# Como obter:
#  1. Aceda a https://console.cloud.google.com/
#  2. Crie um projeto e ative a "Gmail API" em "APIs e Serviços" > "Biblioteca".
#  3. Em "Ecrã de consentimento OAuth", configure utilizadores de teste ou publique.
#  4. Em "Credenciais" > "Criar credenciais" > "ID do cliente OAuth":
#     - Tipo de aplicação: Aplicação Web
#     - URIs de redirecionamento autorizados: http://localhost:8000/api/email/oauth/google/callback
#  5. Cole abaixo o ID do Cliente e o Segredo do Cliente:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/google/callback

# ------------------------------------------------------------------------------
# 2. MICROSOFT OUTLOOK / OFFICE 365 (Microsoft Graph OAuth 2.0 Oficial)
# ------------------------------------------------------------------------------
# Como obter:
#  1. Aceda a https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
#  2. Clique em "Novo registo" (New Registration).
#  3. Em "Tipos de conta suportados", selecione "Contas em qualquer diretório organizacional e contas pessoais da Microsoft".
#  4. Em "URI de Redirecionamento" (Web):
#     - URI: http://localhost:8000/api/email/oauth/microsoft/callback
#  5. Em "Certificados e segredos" > "Novo segredo do cliente", gere um segredo.
#  6. Em "Permissões de API", garanta: Mail.ReadWrite, Mail.Send, User.Read, offline_access.
#  7. Cole abaixo o ID da Aplicação (Cliente) e o Valor do Segredo:
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/email/oauth/microsoft/callback
MICROSOFT_TENANT_ID=common

# ------------------------------------------------------------------------------
# 3. SMTP & IMAP (Opcional - Ligação direta por servidor de e-mail / App Password)
# ------------------------------------------------------------------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993

# ==============================================================================
# META WHATSAPP CLOUD API [DESATIVADO NO PAINEL - MANTIDO PARA HISTÓRICO/LEGADO]
# O sistema WhatsApp não foi apagado para preservar a compatibilidade e código.
# ==============================================================================
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_SYSTEM_USER_TOKEN=
WHATSAPP_VERIFY_TOKEN=drexier_whatsapp_verify_token_secret
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
