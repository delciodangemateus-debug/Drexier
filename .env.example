# Copie este ficheiro para .env. Nunca publique as suas chaves.
APP_NAME=Drexier
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-before-use
DATABASE_URL=sqlite:///./data/drexier.db

# Integração opcional com API de IA compatível com OpenAI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# A integração WhatsApp fica intencionalmente sem configuração nesta versão.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
